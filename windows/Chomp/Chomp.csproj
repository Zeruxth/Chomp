<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chomp for Windows. Build on Windows with: dotnet publish windows/Chomp -c Release -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chomp</RootNamespace>
    <AssemblyName>Chomp</AssemblyName>
    <ApplicationIcon>Assets\Chomp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Chomp.Program</StartupObject>
    <Version>0.0.0</Version>
    <Product>Chomp</Product>
    <Copyright>MIT</Copyright>
    <!-- Lets the project compile (not run) on macOS and Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same pixel fonts the Mac app uses. -->
    <Resource Include="..\..\Resources\Fonts\*.ttf" LinkBase="Fonts" />
    <Resource Include="Assets\Chomp.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebP encoding (libwebp inside). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- PDF merge, split, rotate, images to PDF. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDF text for TXT and word counts. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
